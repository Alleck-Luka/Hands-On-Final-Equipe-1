android_app {
    name: "LoRaTile",

    srcs: [
        "src/**/*.java",
    ],

    certificate: "platform",
    privileged: true,

    resource_dirs: [
        "res",
    ],

    libs: [
        "devtitans.loramanager",
    ],

    required: [ "devtitans.loramanager" ],

    platform_apis: true,
    system_ext_specific: true,
}
