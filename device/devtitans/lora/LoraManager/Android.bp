java_library {
    name: "devtitans.loramanager",

    srcs: [ "src/**/*.java" ],

    static_libs: [ "devtitans.lora-V1-java" ],      // Usa a biblioteca gerada pelo AIDL
    required:    [ "devtitans.loramanager.xml" ],   // Requer o arquivo de permissão (abaixo)

    system_ext_specific: true,                      // A biblioteca será instalada na partição system_ext
    platform_apis:       true,                      // Permite usar APIs escondidas ("@hide")
    installable:         true,                      // Copia a biblioteca para a imagem do Android
}

// Copia o arquivo de permissão para o system_ext/etc/permissions
prebuilt_etc {
    name: "devtitans.loramanager.xml",
    src:  "devtitans.loramanager.xml",
    filename_from_src:     true,
    relative_install_path: "permissions",
    system_ext_specific:   true,
}
