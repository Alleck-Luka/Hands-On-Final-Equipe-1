android_app {
    name: "LoraApp",

    srcs:          [ "app/src/**/*.java" ],
    resource_dirs: [ "app/src/main/res" ],
    libs:          [
        "devtitans.loramanager",                        // Manager: biblioteca Java do LoRa (curso)
    ],
    static_libs:   [
        "androidx.recyclerview_recyclerview",            // RecyclerView (historico de mensagens)
    ],

    system_ext_specific: true,                           // O App será instalado na partição system_ext
    platform_apis:       true,                           // Permite usar APIs escondidas ("@hide"), como ServiceManager

    certificate:         "platform",                     // Necessário para uma aplicação do sistema
    privileged:          true,
    use_embedded_native_libs: true,
    manifest: "app/src/main/AndroidManifest.xml",
}
