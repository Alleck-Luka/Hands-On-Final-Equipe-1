# Cria o tipo/rótulo do serviço AIDL (rotulado no arquivo service_contexts)
type lora_service, service_manager_type;

# Cria o tipo/rótulo do daemon (rotulado no arquivo file_contexts)
type lora_daemon, domain;
type lora_daemon_exec, exec_type, vendor_file_type, file_type;

# Permissões
init_daemon_domain(lora_daemon);                        # O daemon será iniciado pelo init
vndbinder_use(lora_daemon);                             # O daemon usará o binder
allow lora_daemon servicemanager:binder { call transfer };

add_service(lora_daemon, lora_service)             # O daemon irá criar o serviço do lora

# Permite acesso aos arquivos do /sys
allow lora_daemon sysfs:file { getattr open read write };

# Cria e Permite leitura da propriedades de sistema do lora
vendor_public_prop(vendor_lora_prop)
allow lora_daemon vendor_lora_prop:file { open getattr map read };

# Permite que apps privilegiados acessem o daemon e o serviço
allow platform_app lora_daemon:binder call;
allow platform_app lora_service:service_manager find;

# Apps normais (untrusted_app) NÃO acessam o daemon: a senha do LoRa (getKey/setKey)
# fica restrita a apps privilegiados. Obs.: o SELinux do binder é por domínio (não por
# método), então não há como liberar apenas os métodos "públicos" para untrusted_app.
# allow untrusted_app lora_daemon:binder call;
# allow untrusted_app lora_service:service_manager find;


allow shell lora_service:service_manager find;
allow shell lora_daemon:binder call;
# Linha em branco para evitar erro de compilação

